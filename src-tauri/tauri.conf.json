{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "No.1 OCI AI Observability Hub",
  "version": "0.1.0",
  "identifier": "com.engchina.no1-oci-ai-observability-hub",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "No.1 OCI AI Observability Hub",
        "width": 1440,
        "height": 960,
        "minWidth": 1040,
        "minHeight": 720,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "msi"],
    "publisher": "engchina",
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
